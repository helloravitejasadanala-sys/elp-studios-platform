# Copy to .env and set values. Never commit .env.
# Demo-only credentials — change before any real client use.

PICPEAK_PORT=3000

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@elp.local
# Min 8 chars (12+ preferred); upper + lower + number; avoid common passwords.
# First boot may force a password change in Admin before APIs unlock.
ADMIN_PASSWORD=ElpDemo2026!
GUEST_PASSWORD=GuestDemo1

BRAND_TITLE="ELP Studios Galleries"
BRAND_DESCRIPTION="Client photo galleries for Mini Momentz, Katha Films, and Tattva Weddings."

# 0 = clients hit the container directly (local demo / LAN)
# 1 = one reverse proxy in front (Cloudflare Tunnel, Nginx Proxy Manager, etc.)
TRUST_PROXY=0
COOKIE_SECURE=auto

# Uncomment when publishing HTTPS gallery links:
# FRONTEND_URL=https://gallery.example.com
